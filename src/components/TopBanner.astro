---
const segment = 'ÚLTIMO DIA  ·  ';
const repeat = 20;
const textBlock = segment.repeat(repeat);
---

<div class="top-banner">
  <div class="marquee-track" data-scroll-marquee aria-hidden="true">
    <span class="marquee-content" data-marquee-half>{textBlock}</span>
    <span class="marquee-content" data-marquee-half>{textBlock}</span>
  </div>
  <a href="#pricing" class="banner-cta" data-cta-location="top-banner">
    GARANTIR VAGA
  </a>
</div>

<script>
  const track = document.querySelector('[data-scroll-marquee]') as HTMLElement;
  const half = document.querySelector('[data-marquee-half]') as HTMLElement;
  if (track && half) {
    let current = 0;
    let target = 0;
    let loopWidth = half.offsetWidth;
    let running = false;

    window.addEventListener('resize', () => { loopWidth = half.offsetWidth; }, { passive: true });

    window.addEventListener('scroll', () => {
      target = window.scrollY * 0.6;
    }, { passive: true });

    function tick() {
      current += (target - current) * 0.12;
      const offset = -(current % loopWidth);
      track.style.transform = `translate3d(${offset}px,0,0)`;
      running = true;
      requestAnimationFrame(tick);
    }

    requestAnimationFrame(tick);
  }
</script>

<style>
  .top-banner {
    position: sticky;
    top: 0;
    width: 100%;
    background: #dc2626;
    overflow: hidden;
    display: flex;
    align-items: center;
    height: 44px;
    z-index: 50;
    isolation: isolate;
  }

  .marquee-track {
    display: flex;
    white-space: nowrap;
    will-change: transform;
    padding-right: 120px;
  }

  @media (min-width: 768px) {
    .marquee-track {
      padding-right: 160px;
    }
  }

  .marquee-content {
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #ffffff;
    padding: 0 0.25rem;
    flex-shrink: 0;
  }

  @media (min-width: 768px) {
    .marquee-content {
      font-size: 0.875rem;
      letter-spacing: 0.1em;
    }
  }

  .banner-cta {
    position: absolute;
    right: 0;
    top: 0;
    bottom: 0;
    display: flex;
    align-items: center;
    padding: 0 1rem;
    background: #fbbf24;
    color: #1c1917;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    transition: background 0.2s ease;
    box-shadow: -4px 0 12px rgba(0, 0, 0, 0.15);
  }

  @media (min-width: 768px) {
    .banner-cta {
      padding: 0 1.5rem;
      font-size: 0.8125rem;
    }
  }

  .banner-cta:hover {
    background: #f59e0b;
  }
</style>
