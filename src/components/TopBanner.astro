---
const segment = 'LOTE UM LIBERADO  ·  ';
const repeat = 20;
const textBlock = segment.repeat(repeat);
---

<div class="top-banner">
  <div class="marquee-track" aria-hidden="true">
    <span class="marquee-content">{textBlock}</span>
    <span class="marquee-content">{textBlock}</span>
  </div>
  <a href="#pricing" class="banner-cta" data-cta-location="top-banner">
    GARANTIR VAGA
  </a>
</div>

<style>
  .top-banner {
    position: sticky;
    top: 0;
    width: 100%;
    background: #dc2626;
    overflow: hidden;
    display: flex;
    align-items: center;
    height: 38px;
    z-index: 40;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.25);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .marquee-track {
    display: flex;
    white-space: nowrap;
    animation: banner-scroll 30s linear infinite;
    padding-right: 120px;
  }

  .marquee-track:hover {
    animation-play-state: paused;
  }

  @media (min-width: 768px) {
    .marquee-track {
      padding-right: 160px;
    }
  }

  .marquee-content {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #ffffff;
    padding: 0 0.25rem;
    flex-shrink: 0;
  }

  @media (min-width: 768px) {
    .marquee-content {
      font-size: 0.8125rem;
      letter-spacing: 0.12em;
    }
  }

  @keyframes banner-scroll {
    from { transform: translate3d(0, 0, 0); }
    to { transform: translate3d(-50%, 0, 0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }

  .banner-cta {
    position: absolute;
    right: 0;
    top: 0;
    bottom: 0;
    display: flex;
    align-items: center;
    padding: 0 1rem;
    background: #fbbf24;
    color: #1c1917;
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    transition: background 0.2s ease;
    box-shadow: -4px 0 8px rgba(0, 0, 0, 0.2);
  }

  @media (min-width: 768px) {
    .banner-cta {
      padding: 0 1.5rem;
      font-size: 0.75rem;
    }
  }

  .banner-cta:hover {
    background: #f59e0b;
  }
</style>
